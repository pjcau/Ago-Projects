# Development Dockerfile for Backend (FastAPI) with hot-reload support
# Build context: ./apps/01/src/backend
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (gcc needed for bcrypt, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Environment variables for development
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DATABASE_URL=postgresql://user:password@db:5432/product_catalog
ENV JWT_SECRET=your_jwt_secret_key_here
ENV JWT_ALGORITHM=HS256
ENV JWT_EXPIRE_MINUTES=30

EXPOSE 8000

# Start with hot-reload enabled
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]